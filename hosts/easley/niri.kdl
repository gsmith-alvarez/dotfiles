output "DP-2" {
    mode "3840x2160@144.001"
    scale 1.5
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

output "DP-1" {
    mode "3840x2160@144.001"
    scale 1.5
    position x=2560 y=0
    variable-refresh-rate on-demand=true
}

workspace "study" {
    open-on-output "DP-1"
}

workspace "utils" {
    open-on-output "DP-2"
}
