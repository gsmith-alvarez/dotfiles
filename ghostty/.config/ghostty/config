# --- Shell & Command ---
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# --- Appearance & Theme ---
theme = Catppuccin Mocha
background-opacity = 0.85
background-blur = true
background-blur-radius = 32
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# --- Font Configuration ---
font-family = "Monaspace Krypton NF"
font-size = 12

# Enable Ligatures and Texture Healing
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

# --- Window & Layout ---
window-decoration = none
window-padding-x = 12
window-padding-y = 12
quit-after-last-window-closed = true

# --- GTK UI ---
gtk-single-instance = true
gtk-titlebar = true
gtk-titlebar-style = native
gtk-wide-tabs = true
gtk-toolbar-style = flat
gtk-tabs-location = top
window-show-tab-bar = auto

# --- Cursor Configuration ---
cursor-style = block
cursor-style-blink = true

# --- Scrollback ---
scrollback-limit = 3023

# --- General Terminal Features ---
mouse-hide-while-typing = true
copy-on-select = true
confirm-close-surface = false
app-notifications = no-clipboard-copy,no-config-reload
notify-on-command-finish = unfocused

# --- Keybindings ---
# General
keybind = shift+enter=text:\n
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Split Navigation
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+l=goto_split:right

# Tab Navigation
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

# Workspace Management
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+==equalize_splits

# Global Actions
keybind = global:super+`=toggle_quick_terminal
