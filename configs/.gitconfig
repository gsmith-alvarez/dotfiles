[include]
    path = ~/.gitconfig.local

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig.work

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    pager = delta
    untrackedCache = true
    preloadIndex = true

[gc]
    auto = 6700

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoSquash = true
    autoStash = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    hyperlink = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = zdiff3

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
[user]
	name = gsmitha
	email = smith.alvarez.g@gmail.com
